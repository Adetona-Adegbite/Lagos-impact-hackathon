generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String      @id @default(cuid())
  phoneNumber          String      @unique
  shopName             String?
  virtualAccountNumber String?     @unique
  virtualAccountName   String?
  virtualBankName      String?
  customerIdentifier   String?     @unique
  createdAt            DateTime    @default(now())
  products             Product[]
  sales                Sale[]
  operations           Operation[]
  payments             Payment[]
}

model Otp {
  id          String   @id @default(cuid())
  phoneNumber String
  code        String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

model Product {
  id            String     @id @default(cuid())
  name          String
  barcode       String
  category      String
  sellingPrice  Float
  purchasePrice Float
  version       Int        @default(1)
  deleted       Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  userId        String
  user          User       @relation(fields: [userId], references: [id])
  inventory     Inventory?
  saleItems     SaleItem[]

  @@unique([barcode, userId])
}

model Inventory {
  id        String   @id @default(cuid())
  productId String   @unique
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
}

model Sale {
  id          String     @id @default(cuid())
  totalAmount Float
  createdAt   DateTime   @default(now())
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  items       SaleItem[]
  payment     Payment?
}

model SaleItem {
  id          String  @id @default(cuid())
  saleId      String
  sale        Sale    @relation(fields: [saleId], references: [id])
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  quantity    Int
  priceAtSale Float
}

model Payment {
  id                   String   @id @default(cuid())
  transactionReference String   @unique
  amount               Float
  settledAmount        Float?
  feeCharged           Float?
  senderName           String?
  remarks              String?
  currency             String   @default("NGN")
  status               String   @default("PENDING")
  userId               String
  user                 User     @relation(fields: [userId], references: [id])
  saleId               String?  @unique
  sale                 Sale?    @relation(fields: [saleId], references: [id])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId, status])
}

enum OpType {
  CREATE
  UPDATE
  DELETE
  ADJUST_STOCK
  CREATE_SALE
}

model Operation {
  id              String   @id @default(cuid())
  clientOpId      String   @unique
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  deviceId        String
  entityType      String
  entityId        String
  opType          OpType
  payload         Json
  baseVersion     Int?
  clientTimestamp DateTime
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
}
